{
  "name": "@suha-ai/driver-mobile",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5175 --strictPort",
    "preview": "vite preview --host 0.0.0.0 --port 5175 --strictPort",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "native:sync": "pnpm build && cap sync",
    "android:open": "pnpm native:sync && cap open android",
    "android:apk": "pnpm native:sync && node scripts/build-android.mjs",
    "ios:open": "pnpm native:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor-community/admob": "8.0.0",
    "@capacitor/android": "8.4.2",
    "@capacitor/app": "8.0.0",
    "@capacitor/core": "8.4.2",
    "@capacitor/ios": "8.4.2",
    "@mediapipe/tasks-vision": "^0.10.22-rc.20250304",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.4.2",
    "@cloudflare/vite-plugin": "1.37.1",
    "@types/node": "22.19.19",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "sharp": "0.34.5",
    "typescript": "^5.9.2",
    "vite": "8.0.13",
    "vitest": "^3.2.4",
    "wrangler": "4.92.0"
  }
}
